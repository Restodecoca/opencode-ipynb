{
  "name": "opencode-ipynb",
  "version": "2.0.0",
  "description": "OpenCode community plugin that adds robust .ipynb (Jupyter Notebook) support: inspect, read, edit, run, outputs, clean, export, reproducibility reports, and warm kernels.",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./lsp": {
      "types": "./dist/lsp.d.ts",
      "import": "./dist/lsp.js"
    },
    "./rpc": {
      "types": "./dist/rpc.d.ts",
      "import": "./dist/rpc.js"
    },
    "./server.js": "./server.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Restodecoca/opencode-ipynb.git"
  },
  "homepage": "https://github.com/Restodecoca/opencode-ipynb",
  "bugs": {
    "url": "https://github.com/Restodecoca/opencode-ipynb/issues"
  },
  "files": [
    "dist",
    "server.js",
    "python/ipynb_runner.py",
    "python/requirements.txt",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "bun": ">=1.4.4"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc -p tsconfig.test.json",
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && bun build src/index.ts --target=bun --outdir=dist --external effect --external \"effect/*\" && bun build src/lsp.ts --target=bun --outdir=dist --external effect --external \"effect/*\" && bun build src/rpc.ts --target=bun --outdir=dist --external effect --external \"effect/*\" && tsc --emitDeclarationOnly --outDir dist",
    "test": "bun test",
    "lint:effect": "tsc --noEmit",
    "prepare:effect-lsp": "effect-language-service patch",
    "prepack": "bun run scripts/prepack-check.ts",
    "test:coverage": "bun test --coverage"
  },
  "keywords": [
    "opencode",
    "plugin",
    "jupyter",
    "ipynb",
    "notebook",
    "effect",
    "typescript"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@opencode/plugin": "^2.2.2",
    "effect": "^4.0.0"
  },
  "dependencies": {},
  "devDependencies": {
    "@effect/language-service": "^0.87.5",
    "@opencode/plugin": "^2.2.2",
    "@types/bun": "^1.4.4",
    "effect": "4.0.6",
    "typescript": "^5.6.0",
    "zod": "4"
  }
}
